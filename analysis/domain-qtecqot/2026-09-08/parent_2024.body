	<div id="fadesource" class="w3-container w3-center w3-animate-zoom" style="z-index:2000;background:#000000;color:white;width:100%;height:40px;text-align:center;position:fixed;bottom:0;margin:auto;border-top:2px solid #ffcc66;border-bottom:2px solid #ffcc66;padding-top:5px">
	This site uses cookies to enhance the user experience. By continuing, you agree to their use. &nbsp;&nbsp; <a href="https://en.wikipedia.org/wiki/HTTP_cookie" target="_blank" style="color:#3399ff">More Info</a>
	&nbsp;&nbsp;&nbsp;
	<button name="button" id="handle" class="tradeButton" style="width:145px;height:33px;color:#3399ff;font-weight:700">I Understand</button>
	</div>	

	<script type="text/javascript">
	var fadesource = document.getElementById('fadesource');
	document.getElementById('handle').onclick = function () 
	{ 
		fadesource.classList.toggle('fade'); 
		setCookie('euconfirm','');
		wait(50);
		setTimeout(gotonone, 2000);
	}

	function wait(ms)
	{
   		var start = new Date().getTime();
	    var end = start;
   		while(end < start + ms) {
     	end = new Date().getTime();
   		}
	}	

	function gotonone()
	{
		document.getElementById('fadesource').style.display = 'none';
	}	
	</script>

	

